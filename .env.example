# ============================================================
# 智能健康助手 — 环境变量模板
# ============================================================
# 开发环境: cp .env.example .env → 填值 → docker compose up -d
# 部署环境: cp .env.example .env → 填值 → docker compose -f docker-compose.deploy.yml up -d
# ============================================================

# ---- 镜像地址 (仅部署版需要，开发版使用本地构建) ----
# IMAGE_NAME=registry.cn-hangzhou.aliyuncs.com/你的命名空间/smart-health-assistant:latest

# ---- 服务端口 (可选，有默认值) ----
# APP_PORT=80               # 应用对外端口
# MYSQL_PORT=3307           # MySQL 对外端口 (避免与宿主机 3306 冲突)
# REDIS_PORT=6379           # Redis 对外端口

# ---- MySQL 数据库 (必填) ----
MYSQL_PASSWORD=replace-with-a-strong-database-password
# MYSQL_DATABASE=smart_health_db              # 数据库名 (默认值)
# SPRING_DATASOURCE_USERNAME=root             # 数据库用户 (默认值)

# ---- JWT 鉴权 (必填) ----
# 生成方法: openssl rand -base64 32
JWT_SECRET=replace-with-base64-encoded-32-byte-secret
# JWT_EXPIRATION=604800000                    # Token 过期毫秒数，默认 7天

# ---- DeepSeek AI (必填) ----
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # API 地址 (默认值)
# DEEPSEEK_MODEL=deepseek-v4-pro              # 模型名称 (默认值)
# DEEPSEEK_TIMEOUT_MS=120000                  # 请求超时毫秒 (默认值)
# DEEPSEEK_TEMPERATURE=0.2                    # 温度 (默认值)
# DEEPSEEK_MAX_TOKENS=4096                    # 最大 Token (默认值)

# ---- CORS 跨域 (可选) ----
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# ---- 上传 (可选) ----
# UPLOAD_AVATAR_MAX_SIZE=5242880             # 头像最大 5MB (默认值)

# ---- MyBatis 日志 (可选) ----
# 生产环境建议清空: MYBATIS_LOG_IMPL=
# MYBATIS_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl
